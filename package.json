{
  "name": "caught-in-express",
  "version": "1.0.4",
  "description": "A lightweight TypeScript-first error handling middleware for Express 5.",
  "license": "MIT",
  "author": {
    "name": "Olawale Mayor",
    "email": "olawalemayor90@gmail.com",
    "url": "https://olawalemayor.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olawalemayor/caught-in-express.git"
  },
  "homepage": "https://github.com/olawalemayor/caught-in-express#readme",
  "bugs": {
    "url": "https://github.com/olawalemayor/caught-in-express/issues"
  },
  "keywords": [
    "express",
    "expressjs",
    "middleware",
    "error-handler",
    "http-errors",
    "typescript",
    "node",
    "api",
    "rest"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
